# Data provider: mt5 (recommended for broker-exact CFD prices) or massive
TRAID_PROVIDER=mt5

# Kronos model configuration
TRAID_MODEL_ID=NeoQuasar/Kronos-small
TRAID_TOKENIZER_ID=NeoQuasar/Kronos-Tokenizer-base
TRAID_MAX_CONTEXT=512
TRAID_TIMEFRAME=5m
TRAID_LOOKBACK=400
TRAID_PRED_LEN=24
TRAID_STREAM_POLL_SECONDS=5
# TRAID_DEVICE=cuda:0

# Exact broker symbols. Change these when your broker uses suffixes such as .a, -ECN, or _pro.
TRAID_XAUUSD_SYMBOL=XAUUSD
TRAID_XAGUSD_SYMBOL=XAGUSD
TRAID_NAS100_SYMBOL=NAS100
TRAID_SPX500_SYMBOL=SPX500

# Optional MT5 connection values. Leave blank to use the terminal's active account.
# MT5_TERMINAL_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe
# MT5_LOGIN=12345678
# MT5_PASSWORD=replace_me
# MT5_SERVER=Broker-Server

# Massive cloud fallback
# MASSIVE_API_KEY=replace_me
MASSIVE_BASE_URL=https://api.massive.com

# Comma-separated frontend origins. Use a concrete origin in production.
TRAID_CORS_ORIGINS=*
