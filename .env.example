# Data provider: mt5 (recommended for broker-exact CFD prices) or massive
TRAID_PROVIDER=mt5

# Kronos model configuration
TRAID_MODEL_ID=NeoQuasar/Kronos-small
TRAID_TOKENIZER_ID=NeoQuasar/Kronos-Tokenizer-base
TRAID_MAX_CONTEXT=512
TRAID_TIMEFRAME=5m
TRAID_LOOKBACK=400
TRAID_PRED_LEN=24
# TRAID_DEVICE=cuda:0

# Live feed cadence. MT5 can remain sub-second; cloud REST snapshots are throttled by the app.
TRAID_QUOTE_POLL_SECONDS=0.5
TRAID_BAR_POLL_SECONDS=2

# Exact broker symbols. Change these when your broker uses suffixes such as .a, -ECN, or _pro.
TRAID_XAUUSD_SYMBOL=XAUUSD
TRAID_XAGUSD_SYMBOL=XAGUSD
TRAID_NAS100_SYMBOL=NAS100
TRAID_SPX500_SYMBOL=SPX500

# Optional MT5 connection values. Leave blank to use the terminal's active account.
# Never expose these values in dashboard JavaScript or commit a real .env file.
# MT5_TERMINAL_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe
# MT5_LOGIN=12345678
# MT5_PASSWORD=replace_me
# MT5_SERVER=Broker-Server

# Trade execution safety. Keep paper mode until a demo account has been validated.
TRAID_TRADING_ENABLED=false
TRAID_TRADING_MODE=paper
# Generate a long random secret and enter the same value in the dashboard settings drawer.
# TRAID_TRADING_API_KEY=replace_with_a_long_random_secret
TRAID_TRADING_MAGIC=260731
TRAID_MAX_ORDER_LOTS=1.0
TRAID_MAX_OPEN_POSITIONS=4
TRAID_MAX_POSITIONS_PER_SYMBOL=1
TRAID_REQUIRE_STOP_LOSS=true
TRAID_TRAILING_POLL_SECONDS=0.5
TRAID_TRAILING_STATE_PATH=data/trailing_stops.json

# Massive cloud fallback
# MASSIVE_API_KEY=replace_me
MASSIVE_BASE_URL=https://api.massive.com

# Comma-separated frontend origins. Replace * with your real dashboard origin in production.
TRAID_CORS_ORIGINS=*
